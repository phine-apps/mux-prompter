#!/usr/bin/env bash
args="$*"

# Drain stdin upfront when piped so upstream commands do not receive EPIPE
# under CI runners where SIGPIPE is ignored (SIG_IGN).
stdin_data=""
if [ ! -t 0 ]; then
  stdin_data=$(cat)
fi

pick_from_stdin() {
  local match_pattern="$1"
  local line
  if [ -n "$match_pattern" ]; then
    grep -m 1 "$match_pattern" <<< "$stdin_data" || true
  else
    while IFS= read -r line || [ -n "$line" ]; do
      if [ -n "$line" ]; then
        echo "$line"
        return 0
      fi
    done <<< "$stdin_data"
  fi
}

if [ -n "$MOCK_LOG_DIR" ]; then
  echo "fzf $*" >> "$MOCK_LOG_DIR/fzf_calls.log"
fi

# Case 1: Template or History selection
if [[ "$args" == *"[Ctrl-R] History"* ]] || [[ "$args" == *"Select a prompt template"* ]]; then
  case "$TEST_STAGE" in
    "git")          echo "Review Git Changes" ; exit 0 ;;
    "staged_git")   echo "Review Staged Git Changes" ; exit 0 ;;
    "logs")         echo "Explain Logs" ; exit 0 ;;
    "error_logs")   echo "Explain Error Logs" ; exit 0 ;;
    "lastcmd")      echo "Analyze Last Cmd" ; exit 0 ;;
    "crosspane")    echo "Cross Pane Review" ; exit 0 ;;
    "customvar")    echo "Custom Variable Test" ; exit 0 ;;
    "file")         echo "Analyze File" ; exit 0 ;;
    "immediate")    echo "!Run Git Status" ; exit 0 ;;
    "broadcast")    echo "Broadcast Command" ; exit 0 ;;
    "error")        echo "Explain Terminal Error" ; exit 0 ;;
    "file_lines")   echo "Extract Lines" ; exit 0 ;;
    "file_path")    echo "File Path Test" ; exit 0 ;;
    "git_worktree") echo "CD to Git Worktree" ; exit 0 ;;
    "cancel_worktree") echo "CD to Git Worktree" ; exit 0 ;;
    "git_commit") echo "Git Commit Test" ; exit 0 ;;
    "cancel_commit") echo "Git Commit Test" ; exit 0 ;;
    "git_commit_diff") echo "Git Commit Diff Test" ; exit 0 ;;
    "git_branch_choose") echo "Git Branch Choose Test" ; exit 0 ;;
    "cancel_branch") echo "Git Branch Choose Test" ; exit 0 ;;
    "git_changed_file") echo "Git Changed File Test" ; exit 0 ;;
    "cancel_changed_file") echo "Git Changed File Test" ; exit 0 ;;
    "hang_test")    echo "Hang Prevention Test" ; exit 0 ;;
    "selected_test") echo "Refactor Selected Code" ; exit 0 ;;
    "delete_template")
      if [ ! -f "$MOCK_LOG_DIR/deleted_once.flag" ]; then
        touch "$MOCK_LOG_DIR/deleted_once.flag"
        echo "🔧 Edit Templates"
        exit 0
      else
        exit 130
      fi
      ;;
    "use_history")
      echo -e "📜 Hello World History...\tHello World from history"
      exit 0
      ;;
    "cancel")
      exit 130
      ;;
    *)
      exit 130
      ;;
  esac
fi

# Case 2: Custom variable select (service)
if [[ "$args" == *"Select value for service"* ]]; then
  echo "frontend"
  exit 0
fi

# Case 3: Single Pane selection
if [[ "$args" == *"Select a pane to import logs from:"* ]]; then
  echo "0.1 | %1 (/mock/home)"
  exit 0
fi

# Case 4: Multiple Panes selection (broadcast)
if [[ "$args" == *"Select target panes for broadcast"* ]]; then
  if [ "$MUX_BACKEND" = "tmux" ]; then
    echo -e "0.0 | %0 (/mock/workspace)\n0.1 | %1 (/mock/home)"
  else
    echo -e "w2:p1 | No Label (/mock/home)\nw2:p3 | Prompter UI (/mock/apps/mux-prompter)"
  fi
  exit 0
fi

# Case 5: File selection
if [[ "$args" == *"Select a file to insert"* ]]; then
  echo "dummy_test_file.txt"
  exit 0
fi

# Case 6: Edit or Delete template selection
if [[ "$args" == *"[Ctrl-D] Delete"* ]] || [[ "$args" == *"Select template to edit"* ]]; then
  if [ "$TEST_STAGE" == "delete_template" ]; then
    echo -e "ctrl-d\nReview Git Changes (review-git.md)"
    exit 0
  fi
fi

# Case 7: Git worktree selection
if [[ "$args" == *"Select a git worktree:"* ]]; then
  if [ "$TEST_STAGE" == "cancel_worktree" ]; then
    exit 130
  fi
  pick_from_stdin "$MOCK_WORKTREE_MATCH"
  exit 0
fi

# Case 8: Git commit selection
if [[ "$args" == *"Select a git commit:"* ]]; then
  if [ "$TEST_STAGE" == "cancel_commit" ]; then
    exit 130
  fi
  pick_from_stdin "$MOCK_COMMIT_MATCH"
  exit 0
fi

# Case 9: Git branch selection
if [[ "$args" == *"Select a git branch:"* ]]; then
  if [ "$TEST_STAGE" == "cancel_branch" ]; then
    exit 130
  fi
  pick_from_stdin "$MOCK_BRANCH_MATCH"
  exit 0
fi

# Case 10: Git changed file selection
if [[ "$args" == *"Select a changed file:"* ]]; then
  if [ "$TEST_STAGE" == "cancel_changed_file" ]; then
    exit 130
  fi
  pick_from_stdin "$MOCK_CHANGED_FILE_MATCH"
  exit 0
fi

# Default fallback
options=()
while IFS= read -r line || [ -n "$line" ]; do
  options+=("$line")
done <<< "$stdin_data"
for opt in "${options[@]}"; do
  clean_opt=$(echo "$opt" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  if [ -n "$clean_opt" ]; then
    echo "$clean_opt"
    exit 0
  fi
done
