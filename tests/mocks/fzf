#!/usr/bin/env bash
args="$*"

if [ -n "$MOCK_LOG_DIR" ]; then
  echo "fzf $*" >> "$MOCK_LOG_DIR/fzf_calls.log"
fi

# Case 1: Template or History selection
if [[ "$args" == *"[Ctrl-R] History"* ]] || [[ "$args" == *"Select a prompt template"* ]]; then
  case "$TEST_STAGE" in
    "git")          echo "Review Git Changes" ; exit 0 ;;
    "staged_git")   echo "Review Staged Git Changes" ; exit 0 ;;
    "logs")         echo "Explain Logs" ; exit 0 ;;
    "error_logs")   echo "Explain Error Logs" ; exit 0 ;;
    "lastcmd")      echo "Analyze Last Cmd" ; exit 0 ;;
    "crosspane")    echo "Cross Pane Review" ; exit 0 ;;
    "customvar")    echo "Custom Variable Test" ; exit 0 ;;
    "file")         echo "Analyze File" ; exit 0 ;;
    "immediate")    echo "!Run Git Status" ; exit 0 ;;
    "broadcast")    echo "Broadcast Command" ; exit 0 ;;
    "error")        echo "Explain Terminal Error" ; exit 0 ;;
    "file_lines")   echo "Extract Lines" ; exit 0 ;;
    "file_path")    echo "File Path Test" ; exit 0 ;;
    "hang_test")    echo "Hang Prevention Test" ; exit 0 ;;
    "selected_test") echo "Refactor Selected Code" ; exit 0 ;;
    "use_history")
      echo "📜 Hello World History... | Hello World from history"
      exit 0
      ;;
    "cancel")
      exit 130
      ;;
    *)
      exit 130
      ;;
  esac
fi

# Case 2: Custom variable select (service)
if [[ "$args" == *"Select value for service:"* ]]; then
  echo "frontend"
  exit 0
fi

# Case 3: Single Pane selection
if [[ "$args" == *"Select a pane to import logs from:"* ]]; then
  echo "0.1 | %1 (/Users/oishik)"
  exit 0
fi

# Case 4: Multiple Panes selection (broadcast)
if [[ "$args" == *"Select target panes for broadcast"* ]]; then
  echo -e "w2:p1 | No Label (/Users/oishik)\nw2:p3 | Prompter UI (/Users/oishik/apps/herdr-prompter)"
  exit 0
fi

# Case 5: File selection
if [[ "$args" == *"Select a file to insert"* ]]; then
  echo "dummy_test_file.txt"
  exit 0
fi

# Default fallback
options=()
while IFS= read -r line || [ -n "$line" ]; do
  options+=("$line")
done
for opt in "${options[@]}"; do
  clean_opt=$(echo "$opt" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  if [ -n "$clean_opt" ]; then
    echo "$clean_opt"
    exit 0
  fi
done
